    {"id":"legend_t","type":"text","x":105,"y":872,"width":470,"height":145,"angle":0,"strokeColor":"#212529","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":2301,"version":1,"versionNonce":2301,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"Important Code Notes\n\nRoles/permissions come from Spatie tables and users.role fallback.\nMenu visibility is permission-based in MenuHelper, not hardcoded by role.\nSeeder names include super-admin, super_admin, Super Admin, customer, and staff.\nThe User model client check uses role = client, while RoleSeeder creates customer.","fontSize":15,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Important Code Notes\n\nRoles/permissions come from Spatie tables and users.role fallback.\nMenu visibility is permission-based in MenuHelper, not hardcoded by role.\nSeeder names include super-admin, super_admin, Super Admin, customer, and staff.\nThe User model client check uses role = client, while RoleSeeder creates customer.","lineHeight":1.25}
